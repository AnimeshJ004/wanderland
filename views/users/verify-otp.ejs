<%- layout("/layouts/boilerplate") %>

<div class="auth-page-wrapper">
    <div class="container d-flex justify-content-center align-items-center min-vh-100 py-5">
        <div class="auth-glass-card neumorphic-3d animate-in">
            <div class="auth-header text-center mb-4">
                <div class="auth-logo mb-3">
                    <i class="fa-solid fa-envelope-circle-check fa-3x text-gradient"></i>
                </div>
                <h2 class="auth-title">Verify Your Email</h2>
                <p class="auth-subtitle">We've sent a 6-digit code to your email.</p>
            </div>

            <form action="/verify-otp" method="POST" class="needs-validation auth-form" novalidate>
                <div class="mb-4 auth-input-group">
                    <label for="otp" class="form-label ps-2">Enter 6-Digit OTP</label>
                    <div class="input-with-icon">
                        <i class="fa-solid fa-key input-icon"></i>
                        <input type="text" class="form-control glass-input text-center fs-4 fw-bold letter-spacing-10" id="otp" name="otp" required maxlength="6" pattern="[0-9]{6}" placeholder="0 0 0 0 0 0" style="letter-spacing: 5px;">
                    </div>
                    <div class="invalid-feedback">Please enter a valid 6-digit OTP.</div>
                </div>

                <button type="submit" class="glass-btn primary w-100 m-0 mb-3">
                    <span class="btn-text">Verify & Continue</span>
                    <i class="fa-solid fa-circle-check ms-2"></i>
                </button>
            </form>

            <div class="auth-footer text-center mt-4">
                <p>Didn't receive the code? <a href="/resend-otp" class="text-gradient fw-bold">Resend OTP</a></p>
            </div>
        </div>
    </div>
</div>
