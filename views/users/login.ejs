<%- layout("/layouts/boilerplate") %>

<div class="auth-page-wrapper">
    <div class="container d-flex justify-content-center align-items-center min-vh-100 py-5">
        <div class="auth-glass-card neumorphic-3d animate-in">
            <div class="auth-header text-center mb-4">
                <div class="auth-logo mb-3">
                    <i class="fa-solid fa-compass fa-3x text-gradient"></i>
                </div>
                <h2 class="auth-title">Welcome Back</h2>
                <p class="auth-subtitle">Continue your exploration on WanderLand</p>
            </div>

            <form action="/login" method="POST" class="needs-validation auth-form" novalidate>
                <div class="mb-3 auth-input-group">
                    <label for="username" class="form-label">Username</label>
                    <div class="input-with-icon">
                        <i class="fa-solid fa-user input-icon"></i>
                        <input type="text" class="form-control glass-input" id="username" name="username" placeholder="Your username" required>
                    </div>
                    <div class="invalid-feedback">Username is required.</div>
                </div>

                <div class="mb-4 auth-input-group">
                    <label for="password" class="form-label">Password</label>
                    <div class="input-with-icon">
                        <i class="fa-solid fa-lock input-icon"></i>
                        <input type="password" class="form-control glass-input border-end-0" id="password" name="password" placeholder="Enter password" required>
                        <button class="btn glass-toggle-btn toggle-password" type="button">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="invalid-feedback">Password is required.</div>
                    <div class="text-end mt-2">
                        <a href="/forgot-password" class="text-gradient small fw-bold">Forgot Password?</a>
                    </div>
                </div>

                <button type="submit" class="glass-btn primary w-100 m-0 mb-3">
                    <span class="btn-text">Login</span>
                    <i class="fa-solid fa-right-to-bracket ms-2"></i>
                </button>
            </form>

            <div class="auth-separator my-4">
                <span>OR</span>
            </div>

            <a href="/auth/google?from=login" class="glass-btn secondary w-100 m-0 d-flex align-items-center justify-content-center gap-2 mb-4">
                <img src="https://authjs.dev/img/providers/google.svg" alt="Google" width="20">
                <span>Continue with Google</span>
            </a>

            <div class="auth-footer text-center">
                <p>Don't have an account? <a href="/signup" class="text-gradient fw-bold">Sign up free</a></p>
            </div>
        </div>
    </div>
</div>
