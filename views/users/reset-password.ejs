<%- layout("/layouts/boilerplate") %>

<div class="auth-page-wrapper">
    <div class="container d-flex justify-content-center align-items-center min-vh-100 py-5">
        <div class="auth-glass-card neumorphic-3d animate-in">
            <div class="auth-header text-center mb-4">
                <div class="auth-logo mb-3">
                    <i class="fa-solid fa-lock-open fa-3x text-gradient"></i>
                </div>
                <h2 class="auth-title">Reset Password</h2>
                <p class="auth-subtitle">Secure your account with a new password.</p>
            </div>

            <form action="/reset-password" method="POST" class="needs-validation auth-form" novalidate>
                <div class="mb-4 auth-input-group">
                    <label for="password" class="form-label">New Password</label>
                    <div class="input-with-icon">
                        <i class="fa-solid fa-key input-icon"></i>
                        <input name="password" id="password" type="password" class="form-control glass-input border-end-0" required minlength="8" placeholder="At least 8 characters">
                        <button class="btn glass-toggle-btn toggle-password" type="button">
                            <i class="fas fa-eye"></i>
                        </button>
                    </div>
                    <div class="invalid-feedback">Password must be at least 8 characters long.</div>
                </div>

                <button type="submit" class="glass-btn primary w-100 m-0 mb-3">
                    <span class="btn-text">Update Password</span>
                    <i class="fa-solid fa-check-double ms-2"></i>
                </button>
            </form>

            <div class="auth-footer text-center mt-4">
                <p>Wait, I remember it! <a href="/login" class="text-gradient fw-bold">Back to Login</a></p>
            </div>
        </div>
    </div>
</div>
