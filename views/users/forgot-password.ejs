<%- layout("/layouts/boilerplate") %>

<div class="auth-page-wrapper">
    <div class="container d-flex justify-content-center align-items-center min-vh-100 py-5">
        <div class="auth-glass-card neumorphic-3d animate-in">
            <div class="auth-header text-center mb-4">
                <div class="auth-logo mb-3">
                    <i class="fa-solid fa-unlock-keyhole fa-3x text-gradient"></i>
                </div>
                <h2 class="auth-title">Forgot Password</h2>
                <p class="auth-subtitle">No worries! Enter your email and we'll send you an OTP.</p>
            </div>

            <form action="/forgot-password" method="POST" class="needs-validation auth-form" novalidate>
                <div class="mb-4 auth-input-group">
                    <label for="email" class="form-label">Email Address</label>
                    <div class="input-with-icon">
                        <i class="fa-solid fa-envelope input-icon"></i>
                        <input type="email" class="form-control glass-input" id="email" name="email" placeholder="name@example.com" required>
                    </div>
                    <div class="invalid-feedback">Please provide a valid email.</div>
                </div>

                <button type="submit" class="glass-btn primary w-100 m-0 mb-3">
                    <span class="btn-text">Send OTP</span>
                    <i class="fa-solid fa-paper-plane ms-2"></i>
                </button>
            </form>

            <div class="auth-footer text-center mt-4">
                <p>Remember your password? <a href="/login" class="text-gradient fw-bold">Back to Login</a></p>
            </div>
        </div>
    </div>
</div>
