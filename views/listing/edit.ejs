<%- layout("/layouts/boilerplate") %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="auth-glass-card neumorphic-3d animate-in mx-auto w-100" style="max-width: 100%;">
                <div class="form-header text-center mb-5">
                    <div class="icon-box-lg mb-3">
                        <i class="fa-solid fa-pen-to-square text-gradient fa-3x"></i>
                    </div>
                    <h2 class="auth-title">Edit Your Listing</h2>
                    <p class="auth-subtitle">Update your property details and photos</p>
                </div>

                <!-- Current Image Preview -->
                <div class="col-12 mb-5">
                    <label class="form-label fw-700 ps-2 mb-3">Current Listing Image</label>
                    <div class="glass-card-sm p-3 text-center" style="border-radius: 20px;">
                        <img src="<%= listing.image.url %>" class="img-fluid rounded-4 shadow-sm" style="max-height: 300px; width: 100%; object-fit: cover;" alt="Preview">
                    </div>
                </div>

                <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation row g-4" enctype="multipart/form-data">
                    <!-- Title -->
                    <div class="col-12 auth-input-group">
                        <label for="title" class="form-label">Property Title</label>
                        <div class="input-with-icon">
                            <i class="fa-solid fa-heading input-icon"></i>
                            <input name="listing[title]" value="<%= listing.title %>" type="text" class="form-control glass-input" required />
                        </div>
                        <div class="invalid-feedback">Title is required.</div>
                    </div>

                    <!-- Description -->
                    <div class="col-12 auth-input-group">
                        <label for="description" class="form-label">Description</label>
                        <textarea name="listing[description]" rows="4" class="form-control glass-input p-4 ps-5" required style="padding-left: 50px !important;"><%= listing.description %></textarea>
                        <i class="fa-solid fa-align-left input-icon" style="top: 25px;"></i>
                        <div class="invalid-feedback">Please enter a short description.</div>
                    </div>

                    <!-- Image Upload -->
                    <div class="col-12 auth-input-group">
                        <label for="image" class="form-label">Upload New Images (Optional)</label>
                        <div class="input-with-icon">
                            <i class="fa-solid fa-cloud-arrow-up input-icon"></i>
                            <input name="listing[image]" type="file" class="form-control glass-input" multiple />
                        </div>
                        <div class="small text-muted mt-1 ps-2">Leave blank to keep existing images. You can select multiple.</div>
                    </div>

                    <!-- Booking URL -->
                    <div class="col-12 auth-input-group">
                        <label for="bookingUrl" class="form-label">Airbnb Booking Link</label>
                        <div class="input-with-icon">
                            <i class="fa-brands fa-airbnb input-icon"></i>
                            <input name="listing[bookingUrl]" value="<%= listing.bookingUrl %>" placeholder="https://www.airbnb.com/rooms/..." type="url" class="form-control glass-input" />
                        </div>
                    </div>

                    <!-- Price & Country -->
                    <div class="col-md-6 auth-input-group">
                        <label for="price" class="form-label">Price per Night</label>
                        <div class="input-with-icon">
                            <i class="fa-solid fa-indian-rupee-sign input-icon"></i>
                            <input name="listing[price]" value="<%= listing.price %>" type="number" class="form-control glass-input" required />
                        </div>
                        <div class="invalid-feedback">Price should be a valid number.</div>
                    </div>

                    <div class="col-md-6 auth-input-group">
                        <label for="country" class="form-label">Country</label>
                        <div class="input-with-icon">
                            <i class="fa-solid fa-globe input-icon"></i>
                            <input name="listing[country]" value="<%= listing.country %>" type="text" class="form-control glass-input" required />
                        </div>
                        <div class="invalid-feedback">Country is required.</div>
                    </div>

                    <!-- Location -->
                    <div class="col-12 auth-input-group mb-4">
                        <label for="location" class="form-label">Location / City</label>
                        <div class="input-with-icon">
                            <i class="fa-solid fa-map-location-dot input-icon"></i>
                            <input name="listing[location]" value="<%= listing.location %>" type="text" class="form-control glass-input" required />
                        </div>
                        <div class="invalid-feedback">Location is required.</div>
                    </div>

                    <!-- Submit Button -->
                    <div class="col-12 text-center mt-5">
                        <button class="glass-btn primary px-5 py-3 w-100 m-0">
                            <span class="btn-text fs-5">Save Changes</span>
                            <i class="fa-solid fa-check-double ms-2"></i>
                        </button>
                        <a href="/listings/<%= listing._id %>" class="d-block mt-3 text-muted text-decoration-none small hover-underline fw-600">Cancel & Go Back</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
