<%- layout("/layouts/boilerplate") %>

<div class="container-fluid px-lg-5 py-4">
    <!-- Header Section -->
    <div class="listings-header mb-5 animate-in">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="glass-title mb-2">My <span class="text-gradient">Favorites</span></h1>
                <p class="text-muted fw-500">Your collection of dream destinations</p>
            </div>
            <div class="col-md-6 text-md-end">
                <div class="glass-card-sm px-4 py-2 d-inline-flex align-items-center" style="border-radius: 100px;">
                    <i class="fa-solid fa-heart text-gradient me-2"></i>
                    <span class="fw-700 small"><%= favorites.length %> Saved Items</span>
                </div>
            </div>
        </div>
    </div>

    <% if(favorites.length > 0) { %>
        <!-- Grid -->
        <div class="row row-cols-xxl-4 row-cols-xl-3 row-cols-md-2 row-cols-1 g-4">
            <% for(let listing of favorites) { %>
                <div class="col animate-in">
                    <a href="/listings/<%= listing._id %>" class="listing-link">
                        <div class="glass-listing-card neumorphic-3d">
                            <div class="card-img-wrapper">
                                <img src="<%= listing.image.url %>" class="listing-img" alt="<%= listing.title %>">
                                <div class="img-overlay"></div>
                                
                                <!-- Favorite Button (Overlay) -->
                                <div class="favorite-overlay-btn">
                                    <button class="glass-circle-btn favorite-btn favorited" data-listing-id="<%= listing._id %>" style="background-color: #fe424d; color: white;">
                                        <i class="fa-solid fa-heart"></i>
                                    </button>
                                </div>
                            </div>
                            
                            <div class="listing-details p-3">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h5 class="listing-title text-truncate me-2"><%= listing.title %></h5>
                                    <span class="listing-location small text-muted"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %></span>
                                </div>
                                <p class="listing-price mb-0">
                                    <span class="price-amount fw-bold">₹<%= listing.price.toLocaleString("en-IN") %></span>
                                    <span class="text-muted small"> / night</span>
                                </p>
                            </div>
                        </div>
                    </a>
                </div>
            <% } %>
        </div>
    <% } else { %>
        <!-- Empty State -->
        <div class="empty-state text-center py-5 animate-in">
            <div class="icon-box-lg mx-auto mb-4" style="width: 120px; height: 120px; border-radius: 40px; font-size: 3rem;">
                <i class="fa-solid fa-heart-crack text-gradient"></i>
            </div>
            <h2 class="auth-title">No Favorites Yet</h2>
            <p class="auth-subtitle mb-4">Start exploring and save places you love!</p>
            <a href="/listings" class="glass-btn primary px-5">Explore Listings</a>
        </div>
    <% } %>
</div>
