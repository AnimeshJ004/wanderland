<%- layout("/layouts/boilerplate") %>

<div class="container-fluid px-lg-5 py-4">
    <!-- Header Section -->
    <div class="listings-header mb-5 animate-in">
        <div class="row align-items-center">
            <div class="col-md-6">
                <h1 class="glass-title mb-2">Explore <span class="text-gradient">WanderLand</span></h1>
                <p class="text-muted fw-500">Discover unique places to stay around the world</p>
            </div>
            <div class="col-md-6 text-md-end">
                <div class="tax-toggle-wrapper">
                    <div class="glass-card-sm tax-toggle-pill px-4 py-2 d-inline-flex align-items-center">
                        <span class="me-3 fw-600 small">Display total after taxes</span>
                        <div class="form-check form-switch m-0">
                            <input class="form-check-input tax-input-toggle" type="checkbox" role="switch" id="flexSwitchCheckDefault">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Listings Grid -->
    <% if (currentUser) { %>
        <div class="row row-cols-xxl-4 row-cols-xl-3 row-cols-md-2 row-cols-1 g-4">
            <% for(let listing of listings) { %>
                <div class="col animate-in">
                    <a href="/listings/<%= listing._id %>" class="listing-link">
                        <div class="glass-listing-card neumorphic-3d">
                            <div class="card-img-wrapper">
                                <img src="<%= listing.image.url %>" class="listing-img" alt="<%= listing.title %>">
                                <div class="img-overlay"></div>
                                
                                <!-- Favorite Button (Overlay) -->
                                <div class="favorite-overlay-btn">
                                    <button class="glass-circle-btn favorite-btn <%= (currentUser && currentUser.favorites && currentUser.favorites.some(fav => fav.toString() === listing._id.toString())) ? 'favorited' : '' %>" data-listing-id="<%= listing._id %>">
                                        <i class="<%= (currentUser && currentUser.favorites && currentUser.favorites.some(fav => fav.toString() === listing._id.toString())) ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
                                    </button>
                                </div>

                                <div class="listing-badge">
                                    <span class="badge-glass"><i class="fa-solid fa-star me-1"></i> 4.8</span>
                                </div>
                            </div>
                            
                            <div class="listing-details p-3">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <h5 class="listing-title text-truncate me-2"><%= listing.title %></h5>
                                    <span class="listing-location small text-muted"><i class="fa-solid fa-location-dot me-1"></i><%= listing.location %></span>
                                </div>
                                <p class="listing-price mb-0">
                                    <span class="price-amount fw-bold">₹<%= listing.price.toLocaleString("en-IN") %></span>
                                    <span class="text-muted small"> / night</span>
                                    <i class="tax-info text-gradient small ms-1 fw-bold">+18% GST</i>
                                </p>
                            </div>
                        </div>
                    </a>
                </div>
            <% } %>
        </div>
    <% } else { %>
        <!-- Guest View / Login Prompt -->
        <div class="empty-state text-center py-5 animate-in">
            <div class="icon-box-lg mx-auto mb-4" style="width: 120px; height: 120px; border-radius: 40px; font-size: 3rem;">
                <i class="fa-solid fa-lock text-gradient"></i>
            </div>
            <h2 class="auth-title">Discover Exclusive Stays</h2>
            <p class="auth-subtitle mb-4">Log in to WanderLand to browse unique properties and start planning your next journey.</p>
            <div class="d-flex justify-content-center gap-3">
                <a href="/login" class="glass-btn primary px-5 m-0">Log In</a>
                <a href="/signup" class="glass-btn secondary px-5 m-0">Sign Up Free</a>
            </div>
        </div>
    <% } %>
</div>

<script>
    let taxSwitch = document.getElementById("flexSwitchCheckDefault");
    taxSwitch.addEventListener("click", () => {
        let taxInfo = document.getElementsByClassName("tax-info");
        for (info of taxInfo) {
            if (info.style.display != "inline") {
                info.style.display = "inline";
            } else {
                info.style.display = "none";
            }
        }
    });
</script>
