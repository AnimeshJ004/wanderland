<%- layout("/layouts/boilerplate") %>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            <!-- Listing Detail Card -->
            <div class="glass-listing-detail-card neumorphic-3d animate-in">
                <div class="row g-0">
                    <!-- Image Carousel Section -->
                    <div class="col-md-12">
                        <div id="listingCarousel" class="carousel slide detail-img-wrapper" data-bs-ride="false">
                            <!-- Indicators -->
                            <% if(listing.images && listing.images.length > 1) { %>
                                <div class="carousel-indicators glass-indicators">
                                    <% listing.images.forEach((img, index) => { %>
                                        <button type="button" data-bs-target="#listingCarousel" data-bs-slide-to="<%= index %>" class="<%= index === 0 ? 'active' : '' %>" aria-current="<%= index === 0 ? 'true' : 'false' %>"></button>
                                    <% }) %>
                                </div>
                            <% } %>

                            <div class="carousel-inner h-100">
                                <% if(listing.images && listing.images.length > 0) { %>
                                    <% listing.images.forEach((img, index) => { %>
                                        <div class="carousel-item h-100 <%= index === 0 ? 'active' : '' %>">
                                            <img src="<%= img.url %>" class="detail-img d-block w-100 h-100" alt="<%= listing.title %>">
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <div class="carousel-item active h-100">
                                        <img src="<%= listing.image.url %>" class="detail-img d-block w-100 h-100" alt="<%= listing.title %>">
                                    </div>
                                <% } %>
                            </div>

                            <% if(listing.images && listing.images.length > 1) { %>
                                <button class="carousel-control-prev glass-carousel-btn" type="button" data-bs-target="#listingCarousel" data-bs-slide="prev">
                                    <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Previous</span>
                                </button>
                                <button class="carousel-control-next glass-carousel-btn" type="button" data-bs-target="#listingCarousel" data-bs-slide="next">
                                    <span class="carousel-control-next-icon" aria-hidden="true"></span>
                                    <span class="visually-hidden">Next</span>
                                </button>
                            <% } %>

                            <div class="detail-img-overlay"></div>
                            <div class="detail-badge">
                                <span class="badge-glass lg"><i class="fa-solid fa-star me-1"></i> 4.9 (124 reviews)</span>
                            </div>
                        </div>
                    </div>
                    
                    <!-- Info Section -->
                    <div class="col-md-12">
                        <div class="detail-body p-4 p-lg-5">
                            <div class="d-flex justify-content-between align-items-center mb-4">
                                <h1 class="detail-title text-gradient m-0"><%= listing.title %></h1>
                                <div class="detail-actions">
                                    <button class="glass-circle-btn share-btn"><i class="fa-solid fa-share-nodes"></i></button>
                                    <button class="glass-circle-btn favorite-btn ms-2 <%= (currentUser && currentUser.favorites && currentUser.favorites.some(fav => fav.toString() === listing._id.toString())) ? 'favorited' : '' %>" 
                                            data-listing-id="<%= listing._id %>"
                                            style="<%= (currentUser && currentUser.favorites && currentUser.favorites.some(fav => fav.toString() === listing._id.toString())) ? 'background-color: #fe424d; color: white;' : '' %>">
                                        <i class="<%= (currentUser && currentUser.favorites && currentUser.favorites.some(fav => fav.toString() === listing._id.toString())) ? 'fa-solid' : 'fa-regular' %> fa-heart"></i>
                                    </button>
                                </div>
                            </div>

                            <div class="detail-meta d-flex flex-wrap gap-4 mb-5 p-4 glass-card-sm">
                                <div class="meta-item d-flex align-items-center">
                                    <div class="icon-box-sm me-3"><i class="fa-solid fa-user-tie"></i></div>
                                    <div>
                                        <p class="text-muted small m-0">Hosted by</p>
                                        <p class="fw-bold m-0"><%= listing.owner.username %></p>
                                    </div>
                                </div>
                                <div class="meta-item d-flex align-items-center">
                                    <div class="icon-box-sm me-3"><i class="fa-solid fa-location-dot"></i></div>
                                    <div>
                                        <p class="text-muted small m-0">Location</p>
                                        <p class="fw-bold m-0"><%= listing.location %>, <%= listing.country %></p>
                                    </div>
                                </div>
                                <div class="meta-item d-flex align-items-center ms-auto">
                                    <div class="price-tag text-end">
                                        <p class="text-muted small m-0">Price per night</p>
                                        <p class="fw-800 fs-3 m-0 text-gradient">₹<%= listing.price.toLocaleString("en-IN") %></p>
                                        
                                        <% if(listing.bookingUrl) { %>
                                            <a href="<%= listing.bookingUrl %>" target="_blank" class="glass-btn primary m-0 mt-2 py-2 px-4 fs-6">
                                                <i class="fa-brands fa-airbnb me-2"></i> Book on Airbnb
                                            </a>
                                        <% } %>
                                    </div>
                                </div>
                            </div>

                            <div class="detail-description mb-5">
                                <h4 class="fw-700 mb-3">About this place</h4>
                                <p class="lead text-muted"><%= listing.description %></p>
                            </div>

                            <% if(currentUser && listing.owner._id.equals(currentUser._id)) { %>
                                <div class="detail-btns d-flex gap-3 mt-4">
                                    <a href="/listings/<%= listing._id %>/edit" class="glass-btn primary px-5 m-0">
                                        <i class="fa-solid fa-pen-to-square me-2"></i> Edit
                                    </a>
                                    <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE" class="m-0">
                                        <button class="glass-btn secondary px-5 m-0 text-danger">
                                            <i class="fa-solid fa-trash-can me-2"></i> Delete
                                        </button>
                                    </form>
                                </div>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Review Section -->
            <div class="reviews-section mt-5 animate-in">
                <div class="glass-card-sm p-4 p-lg-5">
                    <h3 class="fw-800 mb-4"><i class="fa-solid fa-comments text-gradient me-2"></i> Reviews</h3>
                    
                    <% if(currentUser) { %>
                        <div class="add-review-box mb-5">
                            <h5 class="fw-700 mb-3">Leave a Review</h5>
                            <form action="/listings/<%= listing.id %>/reviews" method="POST" novalidate class="needs-validation">
                                <div class="mb-3 mt-3">
                                    <label for="rating" class="form-label">Rating</label>
                                    <fieldset class="starability-slot">
                                        <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="1" checked aria-label="No rating." />
                                        <input type="radio" id="first-rate1" name="review[rating]" value="1" />
                                        <label for="first-rate1" title="Terrible">1 star</label>
                                        <input type="radio" id="first-rate2" name="review[rating]" value="2" />
                                        <label for="first-rate2" title="Not good">2 stars</label>
                                        <input type="radio" id="first-rate3" name="review[rating]" value="3" />
                                        <label for="first-rate3" title="Average">3 stars</label>
                                        <input type="radio" id="first-rate4" name="review[rating]" value="4" />
                                        <label for="first-rate4" title="Very good">4 stars</label>
                                        <input type="radio" id="first-rate5" name="review[rating]" value="5" />
                                        <label for="first-rate5" title="Amazing">5 stars</label>
                                    </fieldset>
                                </div>
                                <div class="mb-4">
                                    <label for="comment" class="form-label">Comment</label>
                                    <textarea name="review[comment]" id="comment" cols="30" rows="4" class="form-control glass-input" placeholder="Share your experience..." required></textarea>
                                    <div class="invalid-feedback">Please add some comments for review</div>
                                </div>
                                <button class="glass-btn primary m-0 px-5">Submit Review</button>
                            </form>
                        </div>
                    <% } %>

                    <div class="reviews-list row g-4">
                        <% for(review of listing.reviews) { %>
                            <div class="col-md-6">
                                <div class="glass-card-sm p-4 h-100 review-item neumorphic-3d">
                                    <div class="d-flex justify-content-between align-items-start mb-3">
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-sm text-gradient me-2 fw-bold fs-4">
                                                <%= review.author.username[0].toUpperCase() %>
                                            </div>
                                            <h6 class="m-0 fw-bold">@<%= review.author.username %></h6>
                                        </div>
                                        <p class="starability-result" data-rating="<%= review.rating %>"></p>
                                    </div>
                                    <p class="text-muted"><%= review.comment %></p>
                                    <% if(currentUser && review.author._id.equals(currentUser._id)) { %>
                                        <form method="POST" action="/listings/<%= listing._id %>/reviews/<%= review._id %>?_method=DELETE">
                                            <button class="btn btn-sm btn-outline-danger border-0"><i class="fa-solid fa-trash me-1"></i>Delete</button>
                                        </form>
                                    <% } %>
                                </div>
                            </div>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
