<%- layout("/layouts/boilerplate") %>

<div class="glass-home-wrapper">
    <!-- Animated Background -->
    <div class="bg-shape blob-1"></div>
    <div class="bg-shape blob-3"></div>

    <div class="container py-5 mt-4">
        <div class="row">
            <div class="col-lg-10 offset-lg-1 animate-in">
                <div class="hero-glass-card text-start p-4 p-md-5">
                    <h1 class="glass-title mb-4">Privacy <span class="text-gradient">Policy</span></h1>
                    <p class="text-muted mb-5">Your privacy is important to us. This policy explains how WanderLand collects, uses, and protects your personal information.</p>

                    <div class="glass-feature-card neumorphic-3d p-4 mb-4 text-start">
                        <h4 class="fw-bold mb-3"><i class="fa-solid fa-database text-danger me-2"></i>1. Information Collection</h4>
                        <p class="text-muted">We collect information that you provide directly to us when you create an account, such as your username, email address, and any hotel experiences or photos you share on the platform.</p>
                    </div>

                    <div class="glass-feature-card neumorphic-3d p-4 mb-4 text-start">
                        <h4 class="fw-bold mb-3"><i class="fa-solid fa-eye text-danger me-2"></i>2. How We Use Data</h4>
                        <p class="text-muted">We use your information to provide our services, including community experience sharing, AI-powered recommendations, and communicating important updates about your account.</p>
                    </div>

                    <div class="glass-feature-card neumorphic-3d p-4 mb-4 text-start">
                        <h4 class="fw-bold mb-3"><i class="fa-solid fa-shield-check text-danger me-2"></i>3. Data Security</h4>
                        <p class="text-muted">We implement robust security measures to protect your personal data. However, no method of transmission over the internet is 100% secure, and we cannot guarantee absolute security.</p>
                    </div>

                    <div class="mt-5 text-center">
                        <p class="small text-muted">Last updated: April 17, 2026</p>
                        <a href="/home" class="glass-btn secondary mt-2">Back to Home</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
